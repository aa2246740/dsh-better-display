{
  "name": "dsh-better-display",
  "version": "0.3.8",
  "description": "A calmer reading view for DeepSeek Harness: native process details, live reasoning, and clean final answers.",
  "type": "module",
  "license": "MIT",
  "main": "lib/dsh-better-display.js",
  "types": "lib/types/dsh-better-display.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/dsh-better-display.d.ts",
      "default": "./lib/dsh-better-display.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/check-harness-compat.mjs && tsc -p tsconfig.json && tsdown",
    "check:harness": "node scripts/check-harness-compat.mjs",
    "test:official": "node scripts/verify-official-bridge.mjs",
    "test:auto-fold": "node scripts/verify-auto-fold.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "link:harness": "node scripts/link-harness-dependencies.mjs",
    "test:flowcell": "node scripts/verify-flowcell.mjs",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier --check .",
    "deadcode": "knip",
    "duplicates": "jscpd src",
    "debt": "node scripts/check-todo-debt.mjs",
    "changelog": "node scripts/changelog.mjs",
    "check:agents": "node scripts/check-agents-md.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "security:audit": "node scripts/security-audit-report.mjs",
    "check:flags": "node scripts/check-dead-flags.mjs",
    "test:list": "vitest list",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-util-workspace-path": ">=0.2.0-rc.1 <0.2.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-turn-outline": "0.2.0-rc.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.33.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "semver": "^7.7.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0",
    "prettier": "^3.9.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "knip": "^6.42.1",
    "jscpd": "^5.4.1",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2"
  },
  "files": [
    "lib",
    "skills",
    "src",
    "tests",
    "scripts",
    "cordis.yml",
    "cordis.patch.yml",
    "dshx.yml",
    "tsconfig.json",
    "tsdown.config.ts",
    "README.md",
    "README.en.md",
    "DESIGN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "compat",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aa2246740/dsh-better-display.git"
  },
  "homepage": "https://github.com/aa2246740/dsh-better-display#readme",
  "bugs": {
    "url": "https://github.com/aa2246740/dsh-better-display/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dshx",
    "conversation",
    "reasoning",
    "streaming",
    "accessibility"
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{mjs,cjs,js,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
